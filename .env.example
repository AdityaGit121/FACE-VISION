# OPTIONAL. You can leave this empty and add your own API key(s) inside the app instead
# (top bar -> "API"). Supports Gemini, OpenAI, Claude, OpenRouter, Groq, Ollama and any REST API.
# A key here is only used as a fallback when no provider is configured in the app.
GEMINI_API_KEY=
GEMINI_MODEL=

# The server listens on 127.0.0.1 only (your PC). Set HOST=0.0.0.0 to expose it on your network.
# HOST=127.0.0.1
# PORT=3000
